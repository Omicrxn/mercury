{
  "name": "@omicrxn/mercury-docs",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm \"/dev:/\"",
    "dev:content": "velite dev --watch",
    "dev:svelte": "vite dev",
    "build": "velite && node ./scripts/update-velite-output.js && pnpm build:search && vite build",
    "build:search": "node ./scripts/build-search-data.js",
    "preview": "vite preview",
    "check": "velite && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm build:content && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.17.0",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@svecodocs/kit": "latest",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/table-core": "^8.21.3",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "isomorphic-dompurify": "^3.16.0",
    "layerchart": "^2.0.0-next.18",
    "mdsx": "^0.0.7",
    "mode-watcher": "^1.1.0",
    "package-manager-detector": "^1.6.0",
    "paneforge": "1.0.2",
    "phosphor-svelte": "^3.1.0",
    "shiki": "^4.2.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.1.1",
    "svelte-toolbelt": "^0.10.6",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "velite": "^0.3.1",
    "vite": "^8.0.16",
    "vite-plugin-devtools-json": "^1.0.0",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "@omicrxn/mercury": "workspace:*",
    "motion": "^12.40.0",
    "runed": "^0.37.1"
  }
}
